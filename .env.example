# Copy to .env for local development. On Netlify, set these under
# Site configuration > Environment variables.
# Only public, browser-safe values belong here. Never put a Supabase
# service-role key in any VITE_ variable.

# Supabase (used from Phase 2 onwards)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Multiplayer server (used from Phase 4 onwards)
VITE_COLYSEUS_URL=ws://localhost:2567
